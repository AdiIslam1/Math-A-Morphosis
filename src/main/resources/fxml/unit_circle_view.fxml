<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mathamorphosis.ui.visualizations.UnitCircleViewController"
            style="-fx-background-color: #0c0c1e;">

    <!-- ═══════════════════ TOP: Title ═══════════════════ -->
    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="10" bottom="10"/></padding>
            <Label text="Unit Circle Unroller"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            <Label text="Drag the yellow handle or click Auto-Spin to see how trigonometric waves are generated."
                   style="-fx-font-size: 16px; -fx-text-fill: #6868a0;"/>
        </VBox>
    </top>

    <!-- ═══════════════════ CENTER: Circle + Wave panes ═══════════════════ -->
    <center>
        <HBox alignment="CENTER" spacing="30">
            <!-- Left: Unit circle pane — drawn into programmatically -->
            <Pane fx:id="leftPane" prefWidth="500" prefHeight="500"
                  style="-fx-background-color: #1c1c38; -fx-background-radius: 12px;
                         -fx-border-color: #32325a; -fx-border-radius: 12px; -fx-border-width: 2px;"/>

            <!-- Right: Wave pane -->
            <Pane fx:id="rightPane" prefWidth="600" prefHeight="500"
                  style="-fx-background-color: #1c1c38; -fx-background-radius: 12px;
                         -fx-border-color: #32325a; -fx-border-radius: 12px; -fx-border-width: 2px;"/>
        </HBox>
    </center>

    <!-- ═══════════════════ BOTTOM: Controls ═══════════════════ -->
    <bottom>
        <VBox spacing="0">

            <!-- Function selector + toggles row -->
            <HBox alignment="CENTER" spacing="30">
                <padding><Insets top="20" bottom="0" left="20" right="20"/></padding>

                <RadioButton fx:id="sineRadio" text="Sine (Height)" selected="true"
                             style="-fx-text-fill: #10b981; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <RadioButton fx:id="cosineRadio" text="Cosine (Width)"
                             style="-fx-text-fill: #f43f5e; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <RadioButton fx:id="tangentRadio" text="Tangent (Slope)"
                             style="-fx-text-fill: #f97316; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <ToggleButton fx:id="refTriangleToggle" text="Show Reference Triangle"
                              style="-fx-font-size: 14px; -fx-text-fill: #6868a0; -fx-font-weight: bold;
                                     -fx-background-color: #1a1a38; -fx-border-color: #32325a; -fx-border-width: 2px;
                                     -fx-border-radius: 8px; -fx-background-radius: 8px;
                                     -fx-padding: 10px 20px; -fx-cursor: hand;"/>

                <ToggleButton fx:id="autoSpinToggle" text="▶ Auto-Spin"
                              style="-fx-font-size: 14px; -fx-text-fill: #5ba8e0; -fx-font-weight: bold;
                                     -fx-background-color: #22224a; -fx-border-color: #5ba8e0;
                                     -fx-border-radius: 8px; -fx-border-width: 2px;
                                     -fx-padding: 10px 20px; -fx-cursor: hand;"/>
            </HBox>

            <!-- Speed slider row -->
            <HBox alignment="CENTER" spacing="12">
                <padding><Insets top="0" right="20" bottom="12" left="20"/></padding>
                <Label text="Animation Speed:"
                       style="-fx-text-fill: #6868a0; -fx-font-size: 14px;"/>
                <Slider fx:id="speedSlider" min="0.002" max="0.08" value="0.01" prefWidth="300"
                        style="-fx-accent: #5ba8e0;"/>
                <Label fx:id="speedValueLabel" text="1.0×"
                       style="-fx-text-fill: #5ba8e0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-width: 40px;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
