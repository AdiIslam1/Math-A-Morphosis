<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Root is a StackPane so the ResizableCanvas fills the entire area
  and the UI overlay (BorderPane) floats on top.
  The canvas itself is created programmatically in the controller
  because it is a non-standard ResizableCanvas subclass.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="com.mathamorphosis.ui.visualizations.FourierSeriesViewController"
           style="-fx-background-color: #14142a;"
           minWidth="0" minHeight="0"
           prefWidth="1000" prefHeight="600"
           maxWidth="Infinity" maxHeight="Infinity">

    <!-- Canvas is injected by the controller as child [0] -->

    <!-- ═══════════════════ UI Overlay (non-picking background) ═══════════════════ -->
    <BorderPane pickOnBounds="false">

        <!-- TOP: Title + subtitle -->
        <top>
            <VBox alignment="CENTER" spacing="5" maxWidth="600"
                  style="-fx-background-color: rgba(15,23,42,0.85); -fx-background-radius: 0 0 20 20;
                         -fx-border-color: #32325a; -fx-border-width: 0 1px 1px 1px; -fx-border-radius: 0 0 20 20;">
                <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
                <Label text="Fourier Series Epicycles"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                <Label text="Pan with mouse drag, Zoom with scroll. Draw in 2D mode!"
                       style="-fx-font-size: 14px; -fx-text-fill: #6868a0;"/>
            </VBox>
        </top>

        <!-- BOTTOM: Controls bar -->
        <bottom>
            <HBox alignment="CENTER" spacing="20" maxWidth="800"
                  style="-fx-background-color: rgba(15,23,42,0.85); -fx-background-radius: 25;
                         -fx-border-color: #32325a; -fx-border-width: 1px; -fx-border-radius: 25;">
                <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>
                <BorderPane.margin><Insets bottom="20"/></BorderPane.margin>

                <Label text="Mode:"
                       style="-fx-text-fill: #5ba8e0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="modeCombo"
                          style="-fx-background-color: #0d1b2e; -fx-border-color: #5ba8e0;
                                 -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1.5px;
                                 -fx-font-size: 13px; -fx-font-style: italic; -fx-font-weight: bold;
                                 -fx-text-fill: #5ba8e0; -fx-padding: 4 8;"/>

                <Label text="Circles:"
                       style="-fx-text-fill: #10b981; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Slider fx:id="termsSlider" min="1" max="150" value="5"
                        showTickMarks="false" prefWidth="120"/>

                <Label text="Speed:"
                       style="-fx-text-fill: #c084fc; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Slider fx:id="speedSlider" min="0.005" max="0.1" value="0.02"
                        showTickMarks="false" prefWidth="120"/>
            </HBox>
        </bottom>
    </BorderPane>

    <!-- Info text overlay (top-left) -->
    <BorderPane pickOnBounds="false">
        <padding><Insets top="20" left="20"/></padding>
        <top>
            <Label fx:id="infoLabel" text=""
                   style="-fx-text-fill: #facc15; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </top>
    </BorderPane>

</StackPane>
